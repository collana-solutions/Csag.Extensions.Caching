<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Version>4.0.0</Version>
    <Description>Strongly typed caching with enum cache identifiers instead of magic strings: the IMemoryCache&lt;TCacheId&gt; and IDistributedCache&lt;TCacheId&gt; interfaces, their base classes, CacheEntryOptions and the CacheKey attribute. The InMemory, Distributed and RedisHybrid packages implement them.</Description>
    <PackageTags>cache caching enum strongly-typed abstractions</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
    <PackageReference Include="Csag.CodeAnalysis" Version="3.3.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
