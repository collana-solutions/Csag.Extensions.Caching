<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Version>4.0.0</Version>
    <Description>Strongly typed IDistributedCache&lt;TCacheId&gt; with enum cache identifiers that combines a local in-memory cache with Redis and keeps the instances in sync through Redis pub/sub (Foundatio.Redis). Values are serialized with MessagePack.</Description>
    <PackageTags>cache caching enum strongly-typed redis hybrid messagepack foundatio</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Foundatio.MessagePack" Version="13.0.5" />
    <PackageReference Include="Foundatio.Redis" Version="13.0.5" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
    <PackageReference Include="Csag.CodeAnalysis" Version="3.3.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Csag.Extensions.Caching.Abstractions\Csag.Extensions.Caching.Abstractions.csproj" />
  </ItemGroup>

</Project>
